<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent/>

    <artifactId>vadmin-bom</artifactId>
    <packaging>pom</packaging>
    <name>VAdmin BOM</name>
    <description>Consumer import that aligns published VAdmin modules and the Vaadin line. It does not manage Spring Boot.</description>

    <!--
        Keep this list identical to vadmin-parent dependencyManagement.
        ConsumerBomContractTest rejects either side drifting.
        A BOM import also sees the parent section, so the parent must not grow
        an internal-only line such as Spring Boot or Flyway.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.huahill</groupId>
                <artifactId>vadmin-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.huahill</groupId>
                <artifactId>vadmin-platform</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.huahill</groupId>
                <artifactId>vadmin-flow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.huahill</groupId>
                <artifactId>vadmin-spring-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.huahill</groupId>
                <artifactId>vadmin-spring-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.huahill</groupId>
                <artifactId>vadmin-spring-boot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.huahill</groupId>
                <artifactId>vadmin-spring-flow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.huahill</groupId>
                <artifactId>vadmin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.huahill</groupId>
                <artifactId>vadmin-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
